{
  "info": {
    "name": "LMS Monorepo – gRPC API",
    "description": "Postman collection covering every gRPC RPC defined in the LMS monorepo.\n\nTransport: gRPC (h2c / HTTP/2 clear-text in local dev).\nDefault host: localhost:18080 (docker-compose).\n\nPublic methods (no JWT):\n  AuthService/Hello, InitiateSignup, VerifySignupOTPs, LoginPrimary, SelectLoginMFAFactor, VerifyLoginMFA, RefreshToken\n\nProtected methods (JWT required):\n  AuthService/SetupTOTP, VerifyTOTPSetup, ChangePassword, Logout\n  AuthService/BeginWebAuthnRegistration, FinishWebAuthnRegistration, BeginWebAuthnLogin, FinishWebAuthnLogin\n  OnboardingService/CompleteBorrowerOnboarding",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "grpc_host",
      "value": "localhost:18080",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "registration_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "mfa_session_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "device_id",
      "value": "postman-device-001",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "AuthService",
      "description": "auth.v1.AuthService – authentication, signup, login, MFA, WebAuthn, and token management.",
      "item": [
        {
          "name": "Hello",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{grpc_host}}/auth.v1.AuthService/Hello",
              "host": ["{{grpc_host}}"],
              "path": ["auth.v1.AuthService", "Hello"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Public – Simple health/greeting check.\n\nRequest: HelloRequest { name }\nResponse: HelloResponse { message }"
          },
          "response": [
            {
              "name": "Hello – example response",
              "status": "OK",
              "body": "{\n  \"message\": \"Hello, Postman!\"\n}"
            }
          ]
        },
        {
          "name": "InitiateSignup",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{grpc_host}}/auth.v1.AuthService/InitiateSignup",
              "host": ["{{grpc_host}}"],
              "path": ["auth.v1.AuthService", "InitiateSignup"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"borrower@example.com\",\n  \"phone\": \"+919876543210\",\n  \"password\": \"Str0ngP@ssw0rd!\",\n  \"role\": \"USER_ROLE_BORROWER\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Public – Start a new user registration. OTPs are sent to the provided email and phone.\n\nRequest: SignupRequest { email, phone, password, role }\nResponse: SignupResponse { registration_id }\n\nEnum role values: USER_ROLE_UNSPECIFIED, USER_ROLE_ADMIN, USER_ROLE_MANAGER, USER_ROLE_OFFICER, USER_ROLE_BORROWER"
          },
          "response": [
            {
              "name": "InitiateSignup – example response",
              "status": "OK",
              "body": "{\n  \"registration_id\": \"reg_abc123\"\n}"
            }
          ]
        },
        {
          "name": "VerifySignupOTPs",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{grpc_host}}/auth.v1.AuthService/VerifySignupOTPs",
              "host": ["{{grpc_host}}"],
              "path": ["auth.v1.AuthService", "VerifySignupOTPs"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"registration_id\": \"{{registration_id}}\",\n  \"email_code\": \"123456\",\n  \"phone_code\": \"654321\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Public – Verify both email and phone OTPs sent during signup.\n\nRequest: VerifyOTPsRequest { registration_id, email_code, phone_code }\nResponse: VerifyOTPsResponse { verified }"
          },
          "response": [
            {
              "name": "VerifySignupOTPs – example response",
              "status": "OK",
              "body": "{\n  \"verified\": true\n}"
            }
          ]
        },
        {
          "name": "SetupTOTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{grpc_host}}/auth.v1.AuthService/SetupTOTP",
              "host": ["{{grpc_host}}"],
              "path": ["auth.v1.AuthService", "SetupTOTP"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"registration_id\": \"{{registration_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Protected – Generate a TOTP secret and provisioning URI for authenticator-app setup.\n\nRequest: SetupTOTPRequest { registration_id }\nResponse: SetupTOTPResponse { secret, provisioning_uri }"
          },
          "response": [
            {
              "name": "SetupTOTP – example response",
              "status": "OK",
              "body": "{\n  \"secret\": \"JBSWY3DPEHPK3PXP\",\n  \"provisioning_uri\": \"otpauth://totp/LMS:borrower@example.com?secret=JBSWY3DPEHPK3PXP&issuer=LMS\"\n}"
            }
          ]
        },
        {
          "name": "VerifyTOTPSetup",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{grpc_host}}/auth.v1.AuthService/VerifyTOTPSetup",
              "host": ["{{grpc_host}}"],
              "path": ["auth.v1.AuthService", "VerifyTOTPSetup"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"registration_id\": \"{{registration_id}}\",\n  \"code\": \"123456\",\n  \"device_id\": \"{{device_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Protected – Verify the TOTP code to complete authenticator enrollment. Returns auth tokens on success.\n\nRequest: VerifyTOTPSetupRequest { registration_id, code, device_id }\nResponse: AuthTokens { access_token, refresh_token }"
          },
          "response": [
            {
              "name": "VerifyTOTPSetup – example response",
              "status": "OK",
              "body": "{\n  \"access_token\": \"eyJhbGciOiJIUzI1NiIs...\",\n  \"refresh_token\": \"dGhpcyBpcyBhIHJlZnJl...\"\n}"
            }
          ]
        },
        {
          "name": "LoginPrimary",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{grpc_host}}/auth.v1.AuthService/LoginPrimary",
              "host": ["{{grpc_host}}"],
              "path": ["auth.v1.AuthService", "LoginPrimary"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email_or_phone\": \"borrower@example.com\",\n  \"password\": \"Str0ngP@ssw0rd!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Public – Step 1 of login. Validates credentials and returns MFA session with allowed factors.\n\nRequest: LoginRequest { email_or_phone, password }\nResponse: LoginPrimaryResponse { mfa_session_id, allowed_factors[] }"
          },
          "response": [
            {
              "name": "LoginPrimary – example response",
              "status": "OK",
              "body": "{\n  \"mfa_session_id\": \"mfa_sess_xyz789\",\n  \"allowed_factors\": [\"totp\", \"email_otp\", \"phone_otp\"]\n}"
            }
          ]
        },
        {
          "name": "SelectLoginMFAFactor",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{grpc_host}}/auth.v1.AuthService/SelectLoginMFAFactor",
              "host": ["{{grpc_host}}"],
              "path": ["auth.v1.AuthService", "SelectLoginMFAFactor"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mfa_session_id\": \"{{mfa_session_id}}\",\n  \"factor\": \"totp\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Public – Step 2 of login. Choose which MFA factor to use for verification.\n\nRequest: SelectLoginMFAFactorRequest { mfa_session_id, factor }\nResponse: SelectLoginMFAFactorResponse { challenge_sent, challenge_target }"
          },
          "response": [
            {
              "name": "SelectLoginMFAFactor – example response",
              "status": "OK",
              "body": "{\n  \"challenge_sent\": true,\n  \"challenge_target\": \"b****r@example.com\"\n}"
            }
          ]
        },
        {
          "name": "VerifyLoginMFA (TOTP)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{grpc_host}}/auth.v1.AuthService/VerifyLoginMFA",
              "host": ["{{grpc_host}}"],
              "path": ["auth.v1.AuthService", "VerifyLoginMFA"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mfa_session_id\": \"{{mfa_session_id}}\",\n  \"totp_code\": \"123456\",\n  \"device_id\": \"{{device_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Public – Step 3 of login. Verify MFA challenge with a TOTP code. Returns auth tokens on success.\n\nRequest: VerifyLoginMFARequest { mfa_session_id, totp_code (oneof factor), device_id }\nResponse: AuthTokens { access_token, refresh_token }\n\nThe 'factor' field is a oneof; use exactly one of: totp_code, webauthn_assertion, email_otp_code, phone_otp_code."
          },
          "response": [
            {
              "name": "VerifyLoginMFA (TOTP) – example response",
              "status": "OK",
              "body": "{\n  \"access_token\": \"eyJhbGciOiJIUzI1NiIs...\",\n  \"refresh_token\": \"dGhpcyBpcyBhIHJlZnJl...\"\n}"
            }
          ]
        },
        {
          "name": "VerifyLoginMFA (Email OTP)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{grpc_host}}/auth.v1.AuthService/VerifyLoginMFA",
              "host": ["{{grpc_host}}"],
              "path": ["auth.v1.AuthService", "VerifyLoginMFA"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mfa_session_id\": \"{{mfa_session_id}}\",\n  \"email_otp_code\": \"123456\",\n  \"device_id\": \"{{device_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Public – Step 3 of login. Verify MFA challenge with an email OTP code.\n\nRequest: VerifyLoginMFARequest { mfa_session_id, email_otp_code (oneof factor), device_id }\nResponse: AuthTokens { access_token, refresh_token }"
          },
          "response": [
            {
              "name": "VerifyLoginMFA (Email OTP) – example response",
              "status": "OK",
              "body": "{\n  \"access_token\": \"eyJhbGciOiJIUzI1NiIs...\",\n  \"refresh_token\": \"dGhpcyBpcyBhIHJlZnJl...\"\n}"
            }
          ]
        },
        {
          "name": "VerifyLoginMFA (Phone OTP)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{grpc_host}}/auth.v1.AuthService/VerifyLoginMFA",
              "host": ["{{grpc_host}}"],
              "path": ["auth.v1.AuthService", "VerifyLoginMFA"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mfa_session_id\": \"{{mfa_session_id}}\",\n  \"phone_otp_code\": \"654321\",\n  \"device_id\": \"{{device_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Public – Step 3 of login. Verify MFA challenge with a phone OTP code.\n\nRequest: VerifyLoginMFARequest { mfa_session_id, phone_otp_code (oneof factor), device_id }\nResponse: AuthTokens { access_token, refresh_token }"
          },
          "response": [
            {
              "name": "VerifyLoginMFA (Phone OTP) – example response",
              "status": "OK",
              "body": "{\n  \"access_token\": \"eyJhbGciOiJIUzI1NiIs...\",\n  \"refresh_token\": \"dGhpcyBpcyBhIHJlZnJl...\"\n}"
            }
          ]
        },
        {
          "name": "ChangePassword",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{grpc_host}}/auth.v1.AuthService/ChangePassword",
              "host": ["{{grpc_host}}"],
              "path": ["auth.v1.AuthService", "ChangePassword"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"Str0ngP@ssw0rd!\",\n  \"new_password\": \"N3wStr0ngP@ss!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Protected – Change the authenticated user's password.\n\nRequest: ChangePasswordRequest { current_password, new_password }\nResponse: ChangePasswordResponse { success }"
          },
          "response": [
            {
              "name": "ChangePassword – example response",
              "status": "OK",
              "body": "{\n  \"success\": true\n}"
            }
          ]
        },
        {
          "name": "BeginWebAuthnRegistration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{grpc_host}}/auth.v1.AuthService/BeginWebAuthnRegistration",
              "host": ["{{grpc_host}}"],
              "path": ["auth.v1.AuthService", "BeginWebAuthnRegistration"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"user_abc123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Protected – Begin WebAuthn/FIDO2 credential registration. Returns a challenge for the authenticator.\n\nRequest: WebAuthnRegRequest { user_id }\nResponse: WebAuthnRegResponse { public_key_credential_creation_options (bytes, base64-encoded) }"
          },
          "response": [
            {
              "name": "BeginWebAuthnRegistration – example response",
              "status": "OK",
              "body": "{\n  \"public_key_credential_creation_options\": \"eyJjaGFsbGVuZ2UiOi...\"\n}"
            }
          ]
        },
        {
          "name": "FinishWebAuthnRegistration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{grpc_host}}/auth.v1.AuthService/FinishWebAuthnRegistration",
              "host": ["{{grpc_host}}"],
              "path": ["auth.v1.AuthService", "FinishWebAuthnRegistration"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"user_abc123\",\n  \"credential\": \"eyJpZCI6InRlc3QtY3Jl...\",\n  \"device_id\": \"{{device_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Protected – Complete WebAuthn credential registration with the authenticator's response. Returns auth tokens on success.\n\nRequest: WebAuthnFinishRegRequest { user_id, credential (bytes, base64-encoded), device_id }\nResponse: AuthTokens { access_token, refresh_token }"
          },
          "response": [
            {
              "name": "FinishWebAuthnRegistration – example response",
              "status": "OK",
              "body": "{\n  \"access_token\": \"eyJhbGciOiJIUzI1NiIs...\",\n  \"refresh_token\": \"dGhpcyBpcyBhIHJlZnJl...\"\n}"
            }
          ]
        },
        {
          "name": "BeginWebAuthnLogin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{grpc_host}}/auth.v1.AuthService/BeginWebAuthnLogin",
              "host": ["{{grpc_host}}"],
              "path": ["auth.v1.AuthService", "BeginWebAuthnLogin"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"user_abc123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Protected – Begin WebAuthn login. Returns an MFA session and a challenge for the authenticator.\n\nRequest: WebAuthnLoginRequest { user_id }\nResponse: WebAuthnLoginResponse { mfa_session_id, public_key_credential_request_options (bytes, base64-encoded) }"
          },
          "response": [
            {
              "name": "BeginWebAuthnLogin – example response",
              "status": "OK",
              "body": "{\n  \"mfa_session_id\": \"mfa_sess_xyz789\",\n  \"public_key_credential_request_options\": \"eyJjaGFsbGVuZ2UiOi...\"\n}"
            }
          ]
        },
        {
          "name": "FinishWebAuthnLogin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{grpc_host}}/auth.v1.AuthService/FinishWebAuthnLogin",
              "host": ["{{grpc_host}}"],
              "path": ["auth.v1.AuthService", "FinishWebAuthnLogin"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mfa_session_id\": \"{{mfa_session_id}}\",\n  \"assertion\": \"eyJpZCI6InRlc3QtYXNz...\",\n  \"device_id\": \"{{device_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Protected – Complete WebAuthn login with the authenticator's assertion. Returns auth tokens on success.\n\nRequest: WebAuthnFinishLoginRequest { mfa_session_id, assertion (bytes, base64-encoded), device_id }\nResponse: AuthTokens { access_token, refresh_token }"
          },
          "response": [
            {
              "name": "FinishWebAuthnLogin – example response",
              "status": "OK",
              "body": "{\n  \"access_token\": \"eyJhbGciOiJIUzI1NiIs...\",\n  \"refresh_token\": \"dGhpcyBpcyBhIHJlZnJl...\"\n}"
            }
          ]
        },
        {
          "name": "RefreshToken",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{grpc_host}}/auth.v1.AuthService/RefreshToken",
              "host": ["{{grpc_host}}"],
              "path": ["auth.v1.AuthService", "RefreshToken"]
            },
            "body": {
              "mode": "raw",
