    },
    {
      "name": "OnboardingService",
      "description": "onboarding.v1.OnboardingService – borrower profile onboarding (post-auth).",
      "item": [
        {
          "name": "CompleteBorrowerOnboarding",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{grpc_host}}/onboarding.v1.OnboardingService/CompleteBorrowerOnboarding",
              "host": ["{{grpc_host}}"],
              "path": ["onboarding.v1.OnboardingService", "CompleteBorrowerOnboarding"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Rahul\",\n  \"last_name\": \"Sharma\",\n  \"date_of_birth\": \"1995-06-15\",\n  \"gender\": \"BORROWER_GENDER_MALE\",\n  \"address_line1\": \"42 MG Road\",\n  \"city\": \"Mumbai\",\n  \"state\": \"Maharashtra\",\n  \"pincode\": \"400001\",\n  \"employment_type\": \"BORROWER_EMPLOYMENT_TYPE_SALARIED\",\n  \"monthly_income\": \"75000.50\",\n  \"profile_completeness_percent\": 100\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Protected – Submit the borrower's full profile to complete onboarding.\n\nRequest: CompleteBorrowerOnboardingRequest {\n  first_name, last_name, date_of_birth (YYYY-MM-DD),\n  gender (enum), address_line1, city, state, pincode,\n  employment_type (enum), monthly_income (decimal string),\n  profile_completeness_percent (int)\n}\nResponse: CompleteBorrowerOnboardingResponse { success }\n\nEnum gender values: BORROWER_GENDER_UNSPECIFIED, BORROWER_GENDER_MALE, BORROWER_GENDER_FEMALE, BORROWER_GENDER_OTHER\nEnum employment_type values: BORROWER_EMPLOYMENT_TYPE_UNSPECIFIED, BORROWER_EMPLOYMENT_TYPE_SALARIED, BORROWER_EMPLOYMENT_TYPE_SELF_EMPLOYED, BORROWER_EMPLOYMENT_TYPE_BUSINESS"
          },
          "response": [
            {
              "name": "CompleteBorrowerOnboarding – example response",
              "status": "OK",
              "body": "{\n  \"success\": true\n}"
            }
          ]
        }
      ]
    }
  ]
}
