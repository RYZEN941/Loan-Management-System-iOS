                  "language": "json"
                }
              }
            },
            "description": "Public – Exchange a valid refresh token for a new access/refresh token pair.\n\nRequest: RefreshTokenRequest { refresh_token, device_id }\nResponse: AuthTokens { access_token, refresh_token }"
          },
          "response": [
            {
              "name": "RefreshToken – example response",
              "status": "OK",
              "body": "{\n  \"access_token\": \"eyJhbGciOiJIUzI1NiIs...\",\n  \"refresh_token\": \"dGhpcyBpcyBhIHJlZnJl...\"\n}"
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "authorization",
